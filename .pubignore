# What pub ships is the tool, its docs, and its metadata — not the harness
# that proves it. rk reads this file when it verifies its own releases, so
# every pattern here must be one rk's matcher understands.
test/
examples/
tool/

# Committed, because rk compiles its own binaries and a pinned lockfile is
# what makes that reproducible — but not shipped, because a consumer of the
# library resolves their own.
pubspec.lock
