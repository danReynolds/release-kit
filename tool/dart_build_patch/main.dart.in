// Temporary entry point for the build command proposed in dart-lang/sdk#64556.
// The command, hooks, compiler and bundling implementation remain SDK code.
import 'dart:io';

import 'package:args/command_runner.dart';
import 'package:dartdev/src/commands/build.dart';
import 'package:pub/src/http.dart';

Future<void> main(List<String> args) async {
  final runner = CommandRunner<int>('dart', 'RK native build preview')
    ..addCommand(
      BuildCommand(recordUseEnabled: false, dataAssetsExperimentEnabled: false),
    );
  runner.argParser.addFlag('verbose', abbr: 'v', negatable: false);
  try {
    exitCode = await runner.run(['build', 'cli', ...args]) ?? 0;
  } on UsageException catch (error) {
    stderr.writeln(error);
    exitCode = 64;
  } finally {
    globalHttpClient.close();
  }
}
